<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".AddProductActivity">
    <ImageView
        android:id="@+id/back"
        android:layout_width="45dp"
        android:layout_height="45dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="28dp"
        android:src="@drawable/back"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/textView3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:text="상품 추가"
        android:textSize="20sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ScrollView
        android:id="@+id/scrollView4"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="110dp"
        android:layout_weight="1"
        app:layout_constraintTop_toBottomOf="@+id/textView3">

        <LinearLayout
            android:id="@+id/linearLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/txt_id"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="상품 ID"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/AddPid"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/register_background"
                android:ems="10"
                android:hint="상품 ID"
                android:inputType="text"
                android:padding="12dp"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/txt_category"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="카테고리"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/category_spinner"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:spinnerMode="dropdown" />


            <TextView
                android:id="@+id/txt_PImg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="상품 메인 이미지"
                android:textSize="14sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/AddPImg"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/addproduct" />

            <TextView
                android:id="@+id/txt_Detail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="상품 상세 이미지"
                android:textSize="14sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/AddPDetailimg"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/addproduct" />

            <TextView
                android:id="@+id/txt_PBrand"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="브랜드명"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/AddPBrand"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/register_background"
                android:ems="10"
                android:hint="브랜드명"
                android:padding="12dp"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/txt_Pname"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="상품명"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/AddPname"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/register_background"
                android:ems="10"
                android:hint="상품명"
                android:padding="12dp"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/txt_PPrice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="상품 가격"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/AddPPrice"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/register_background"
                android:ems="10"
                android:hint="상품 가격"
                android:inputType="textEmailAddress"
                android:padding="12dp"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/txt_AddStock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="상품 재고"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/AddStock"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/register_background"
                android:ems="10"
                android:hint="상품 재고"
                android:inputType="textEmailAddress"
                android:padding="12dp"
                android:textSize="14sp" />
            <TextView
                android:id="@+id/txt_AddSalesCount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="상품 판매량"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/AddSalesCount"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/register_background"
                android:ems="10"
                android:hint="상품 판매량"
                android:inputType="textEmailAddress"
                android:padding="12dp"
                android:textSize="14sp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnMGProductAdd"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginLeft="60dp"
                android:layout_marginRight="60dp"
                android:background="@drawable/green_background"
                android:stateListAnimator="@null"
                android:text="상품 등록하기"
                android:textColor="@color/white"
                android:textSize="18sp" />

        </LinearLayout>
    </ScrollView>


</androidx.constraintlayout.widget.ConstraintLayout>